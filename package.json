{
  "name": "andrews-viana-portfolio-premium",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "ng serve --host 127.0.0.1",
    "build": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "check": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.api.json",
    "test:api": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.2"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@types/node": "^22.15.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0"
  }
}